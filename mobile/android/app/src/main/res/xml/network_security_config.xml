<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) traffic to local development servers -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <!-- Local network range for WiFi-connected physical devices -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="false">192.168.0.26</domain>
    </domain-config>
    <!-- Default: require HTTPS for everything else -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
